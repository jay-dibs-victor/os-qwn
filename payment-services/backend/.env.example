PORT=5050
MONGO_URI=mongodb://localhost:27017/payment_service

# ─── Paystack ────────────────────────────────────────────────────────────────
# Docs: https://paystack.com/docs/api/
# Sign up: https://dashboard.paystack.com/#/signup
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ─── Moniepoint / Monnify ─────────────────────────────────────────────────────
# Moniepoint's online checkout gateway is Monnify.
# Docs: https://developers.monnify.com/api/
# Sign up: https://app.monnify.com/signup
# Get contractCode from your Monnify dashboard → Settings → Contract Codes
MONIEPOINT_API_KEY=MK_TEST_your_api_key
MONIEPOINT_SECRET_KEY=your_moniepoint_secret_key
MONIEPOINT_CONTRACT_CODE=xxxxxxxxxx
# Sandbox: https://sandbox.monnify.com | Production: https://api.monnify.com
MONIEPOINT_API_URL=https://sandbox.monnify.com

# ─── OPay ─────────────────────────────────────────────────────────────────────
# Docs: https://documentation.opaycheckout.com/
# Sign up: https://business.opayweb.com/register
OPAY_MERCHANT_ID=256xxxxxxxxxx
OPAY_SECRET_KEY=your_opay_secret_key
# Sandbox: https://sandboxapi.opaycheckout.com | Production: https://api.opaycheckout.com
OPAY_API_URL=https://sandboxapi.opaycheckout.com

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Docs: https://developer.paypal.com/docs/api/orders/v2/
# Sign up: https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=AxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxA
PAYPAL_CLIENT_SECRET=ExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxE
# Sandbox: https://api-m.sandbox.paypal.com | Production: https://api-m.paypal.com
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Docs: https://stripe.com/docs/api/payment_intents
# Sign up: https://dashboard.stripe.com/register
# Also handles: Mastercard (via card payment)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Kuda Bank ────────────────────────────────────────────────────────────────
# Docs: https://docs.kuda.com  (requires Kuda Business Account)
# Sign up: https://business.kuda.com
# Single-endpoint API: all calls go to baseUrl with different serviceType values
KUDA_EMAIL=merchant@yourbusiness.com
KUDA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# UAT: https://kuda-openapi-uat.kudabank.com/v2.1 | Production: https://kuda-openapi.kuda.com/v2.1
KUDA_API_URL=https://kuda-openapi-uat.kudabank.com/v2.1

# ─── Alipay+ (Antom) ─────────────────────────────────────────────────────────
# Docs: https://docs.alipayplus.com/
# Use Antom/Alipay+ Developer Center for client credentials
# ALIPAY_PRIVATE_KEY must be a full RSA PEM block (-----BEGIN RSA PRIVATE KEY-----)
# ALIPAY_PUBLIC_KEY is the Alipay+ platform public key (used for webhook verification)
ALIPAY_CLIENT_ID=your_alipayplus_client_id
ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIB...\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----"
# Sandbox: https://open-na-sandbox.alipayplus.com | Production: https://open-na.alipayplus.com
ALIPAY_API_URL=https://open-na-sandbox.alipayplus.com

# ─── Google Pay ───────────────────────────────────────────────────────────────
# Docs: https://developers.google.com/pay/api
# Handled client-side via Google Pay JS SDK — token sent to Stripe for processing
GOOGLE_PAY_MERCHANT_ID=BCR2DN4TXXXXXXXXXXXXXXXX
GOOGLE_PAY_MERCHANT_NAME=Taxi Booking App

# ─── Apple Pay ────────────────────────────────────────────────────────────────
# Docs: https://developer.apple.com/documentation/apple_pay_on_the_web
# Requires Apple Developer account with Apple Pay merchant capability
APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.yourcompany.taxibooking
# Apple Pay session validation certificate paths (PEM format)
APPLE_PAY_CERT_PATH=/path/to/merchant_cert.pem
APPLE_PAY_KEY_PATH=/path/to/merchant_key.pem

# AI OS: Standalone Environment Template
# Use this to deploy the AI OS to an independent instance (e.g., AWS EC2, GCP GKE)

# ─── Server Config ───────────────────────────────────────────────────────────
PORT=12010
NODE_ENV=production

# ─── AI & LLM Config ─────────────────────────────────────────────────────────
# Options: 'ollama', 'openai', 'anthropic'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama-external-ip:11434
OLLAMA_MODEL=llama3

# ─── Event Bus & Persistence ─────────────────────────────────────────────────
# For distributed setups, use external RabbitMQ/Temporal cluster IPs
EVENT_BUS_PROVIDER=rabbitmq
RABBITMQ_URL=amqp://user:pass@rabbitmq-external-ip:5672
TEMPORAL_ADDRESS=temporal-cluster-ip:7233
TEMPORAL_TASK_QUEUE=os-task-queue

# ─── Real-time (LiveKit) ─────────────────────────────────────────────────────
LIVEKIT_HOST=https://livekit.yourdomain.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─── Peer Service URLs ───────────────────────────────────────────────────────
# In a distributed setup, these point to the Load Balancer or API Gateway
GATEWAY_URL=https://api.yourdomain.com
RIDE_SERVICE_URL=https://ride-api.yourdomain.com
SHIPPING_SERVICE_URL=https://shipping-api.yourdomain.com

# ─── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=your_ultra_secure_os_secret
DELEGATION_SECRET=your_ai_delegation_secret

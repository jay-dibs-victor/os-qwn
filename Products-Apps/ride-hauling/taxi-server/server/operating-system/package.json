{
  "name": "ai-operating-system",
  "version": "1.0.0",
  "description": "AI-powered Operating System — orchestration layer for all platform services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "dev:worker": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/worker.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "jest"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.21",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.58",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/ollama": "^0.2.3",
    "@langchain/openai": "^0.3.17",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "@types/jsonwebtoken": "^9.0.10",
    "amqplib": "^1.0.3",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.18.6",
    "livekit-server-sdk": "^2.0.0",
    "morgan": "^1.10.0",
    "nats": "^2.29.3",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }

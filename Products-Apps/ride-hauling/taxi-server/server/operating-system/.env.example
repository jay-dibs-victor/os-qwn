# AI OS — Environment Configuration
# Copy to .env and fill in values as needed

# ─── Server ──────────────────────────────────────────────────────────────────
OS_PORT=12010
NODE_ENV=development

# ─── LLM Provider (switch without code changes) ──────────────────────────────
# Options: ollama | openai | anthropic | groq
LLM_PROVIDER=ollama

# Ollama (default — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Groq (set LLM_PROVIDER=groq to use)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# ─── Infrastructure ───────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
TEMPORAL_ADDRESS=localhost:7233

# ─── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─── Service URLs (for AI tools & activities) ─────────────────────────────────
GATEWAY_URL=http://localhost:12000
RIDE_SERVICE_URL=http://localhost:12002
SHIPPING_SERVICE_URL=http://localhost:12006
FLIGHT_INVENTORY_URL=http://localhost:12003
FLIGHT_BOOKING_URL=http://localhost:12004

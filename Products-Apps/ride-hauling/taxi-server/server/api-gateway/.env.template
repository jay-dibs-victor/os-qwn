# API Gateway: Distributed Environment Template

PORT=12000
NODE_ENV=production

# ─── Microservice Locations ──────────────────────────────────────────────────
# In a distributed setup, these point to private IPs or internal Load Balancers
AUTH_SERVICE_URL=http://auth-service-internal-ip:12001
RIDE_SERVICE_URL=http://ride-service-internal-ip:12002
FLIGHT_INVENTORY_URL=http://flight-inventory-internal-ip:12003
FLIGHT_BOOKING_URL=http://flight-booking-internal-ip:12004
SHIPPING_SERVICE_URL=http://shipping-service-internal-ip:12006
AI_OS_URL=http://ai-os-internal-ip:12010

# ─── LiveKit Public URL ──────────────────────────────────────────────────────
# This is used by the gateway to proxy or redirect realtime traffic
LIVEKIT_URL=https://livekit.yourdomain.com

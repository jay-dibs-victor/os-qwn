{
  "name": "taxi-ride-service",
  "version": "1.0.0",
  "description": "Core Ride Management Microservice",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon --watch './**/*.ts' --exec 'ts-node' server.ts",
    "dev:worker": "nodemon --watch './**/*.ts' --exec 'ts-node' worker.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "amqplib": "^1.0.3",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "mongoose": "^8.0.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}

# Ride Service: Standalone Environment Template
# Use this to deploy the Ride Service to an independent instance.

PORT=12002
NODE_ENV=production

# ─── Databases ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://user:pass@mongo-external-ip:27017/taxi_service
REDIS_URL=redis://redis-external-ip:6379

# ─── Messaging ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://user:pass@rabbitmq-external-ip:5672
TEMPORAL_ADDRESS=temporal-cluster-ip:7233

# ─── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=your_auth_secret
SECRET=your_system_secret

# ─── Peer Services ──────────────────────────────────────────────────────────
GATEWAY_URL=https://api.yourdomain.com
AI_OS_URL=https://os.yourdomain.com


# Paystack Configuration
PAYSTACK_SECRET_KEY=PUT_YOURS
PAYSTACK_PUBLIC_KEY=PUT_YOURS
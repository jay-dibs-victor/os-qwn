{
  "name": "GoomLogistics-dev-Proj-repo",
  "version": "1.0.0",
  "description": "Saladin Jake >>> A.K.A Ninjitsu Sensei",
  "main": "./server/dynamic_server/server.js",
  "nyc": {
    "exclude": [
      "UI/",
      "server/dynamic_server/dummy_api/**",
      "server/dynamic_server/config/",
      "server/dynamic_server/dummy_api/tests",
      "server/dynamic_server/mongo_api/tests",
      "helpers/**",
      "server/dynamic_server/sequelize_api/models/db",
      "dist/",
      "server/dynamic_server/server.js",
      "server/static_server/server.js"
    ],
    "include": [
      "**/server"
    ]
  },
  "scripts": {
    "start": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:ride\" \"npm run start:flight-inventory\" \"npm run start:flight-booking\" \"npm run start:flight-notification\" \"npm run start:shipping\"",
    "start:heavy": "cross-env NODE_OPTIONS=--max-old-space-size=8192 concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:ride\" \"npm run start:ride-worker\" \"npm run start:flight-inventory\" \"npm run start:flight-booking\" \"npm run start:shipping\" \"npm run start:ai-os\" \"npm run start:ai-os-worker\"",
    "start:gateway": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/api-gateway/index.ts",
    "start:auth": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/auth-service/server.ts",
    "start:ride": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/ride-service/server.ts",
    "start:ride-worker": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/ride-service/worker.ts",
    "start:flight-inventory": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/flight-inventory-service/server.ts",
    "start:flight-booking": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/flight-booking-service/server.ts",
    "start:flight-notification": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/flight-notification-service/server.ts",
    "start:shipping": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/shipping-service/src/index.ts",
    "start:ai-os": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/operating-system/src/index.ts",
    "start:ai-os-worker": "cross-env NODE_ENV=DEVELOPMENT npx ts-node --transpile-only server/operating-system/src/worker.ts",
    "start:ts": "npm run start",
    "seed": "cross-env NODE_ENV=DEVELOPMENT npx ts-node server/ride-service/mongo_api/migrations/migrations.ts",
    "seed:bulk": "cross-env NODE_ENV=DEVELOPMENT npx ts-node server/ride-service/mongo_api/migrations/bulk_seed.ts",
    "db:seed": "npm run seed",
    "test": "cross-env NODE_ENV=test mocha -r ts-node/register 'server/ride-service/mongo_api/tests/unit/**/*.test.ts' --exit",
    "test:integration": "cross-env NODE_ENV=test mocha -r ts-node/register 'server/ride-service/mongo_api/tests/integration/**/*.test.ts' --exit",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist buildfolder",
    "swagger-gen": "node swagger_gen.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saladinjake/carbooking-withpaystack-wallet-option.git"
  },
  "engines": {
    "node": ">=10.0"
  },
  "private": true,

# API Gateway - points to the backend CRM API gateway
# Local development (docker-compose api-gateway runs on port 3000)
VITE_API_BASE_URL=http://localhost:3000

# Tenant ID for localhost development
VITE_TENANT_ID=tenant-001

# Production example
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_TENANT_ID will be auto-detected from subdomain (e.g., tenant1.yourdomain.com)
